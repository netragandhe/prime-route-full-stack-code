# Dependencies
node_modules/
**/node_modules/

# Production build output
dist/
**/dist/
dist-ssr/

# Environment files (never commit real secrets)
.env
**/.env
!.env.example
!**/.env.example

# Local git upstream backup
**/.git_backup/
**/.git_upstream/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploads directory contents except .gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
